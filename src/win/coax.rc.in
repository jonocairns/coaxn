// Configured by CMake into the build tree. Gives coax.exe an icon and the
// version metadata Explorer shows in a file's Details tab; without it a
// packaged build is an anonymous executable.

#include <winresrc.h>

#include "win/resource.h"

IDI_COAX_APP ICON "@COAX_ICON_PATH@"

VS_VERSION_INFO VERSIONINFO
    FILEVERSION    @PROJECT_VERSION_MAJOR@,@PROJECT_VERSION_MINOR@,@PROJECT_VERSION_PATCH@,0
    PRODUCTVERSION @PROJECT_VERSION_MAJOR@,@PROJECT_VERSION_MINOR@,@PROJECT_VERSION_PATCH@,0
    FILEFLAGSMASK  VS_FFI_FILEFLAGSMASK
    // The project is a proof of concept, so it says so in its own metadata.
    FILEFLAGS      VS_FF_PRERELEASE
    FILEOS         VOS_NT_WINDOWS32
    FILETYPE       VFT_APP
    FILESUBTYPE    VFT2_UNKNOWN
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904B0"  // US English, Unicode
        BEGIN
            VALUE "FileDescription", "Coax - Windows live-TV player"
            VALUE "FileVersion",     "@PROJECT_VERSION@.0"
            VALUE "InternalName",    "coax"
            VALUE "LegalCopyright",  "Copyright (c) 2026 Jono Cairns. MIT License."
            VALUE "OriginalFilename", "coax.exe"
            VALUE "ProductName",     "Coax Native"
            VALUE "ProductVersion",  "@PROJECT_VERSION@"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
